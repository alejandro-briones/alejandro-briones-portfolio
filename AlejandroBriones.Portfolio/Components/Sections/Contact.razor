@using AlejandroBriones.Portfolio.Services

@inject IStringLocalizer<SharedResource> Localizer
@inject CultureService CultureService

<section id="contact" class="contact">

    <div class="container">

        <div class="contact-layout">

            <div class="contact-heading">

                <p class="section-label">
                    @Localizer["Contact_Label"]
                </p>

                <h2>
                    @Localizer["Contact_Title"]
                </h2>

                <p class="contact-description">
                    @Localizer["Contact_Description"]
                </p>

                <a href="@CultureService.CvPath"
                   class="resume-button"
                   download="@CultureService.CvFileName">

                    @Localizer["Contact_DownloadCv"]

                    <i class="bi bi-download"
                       aria-hidden="true"></i>

                </a>

            </div>

            <div class="contact-links">

                <a href="https://www.linkedin.com/in/josealejandrobrionesarroyo"
                   class="contact-link"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label='@Localizer["Contact_LinkedInAriaLabel"]'>

                    <div class="contact-link-content">

                        <i class="bi bi-linkedin contact-icon"
                           aria-hidden="true"></i>

                        <div>

                            <span class="contact-label">
                                LinkedIn
                            </span>

                            <span class="contact-value">
                                @Localizer["Contact_LinkedInValue"]
                            </span>

                        </div>

                    </div>

                    <i class="bi bi-box-arrow-up-right contact-arrow"
                       aria-hidden="true"></i>

                </a>

                <a href="https://mail.google.com/mail/?view=cm&fs=1&to=j.alejandro.briones.a22@gmail.com"
                   class="contact-link"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label='@Localizer["Contact_GmailAriaLabel"]'>

                    <div class="contact-link-content">

                        <i class="bi bi-google contact-icon"
                           aria-hidden="true"></i>

                        <div>

                            <span class="contact-label">
                                Gmail
                            </span>

                            <span class="contact-value">
                                j.alejandro.briones.a22@gmail.com
                            </span>

                        </div>

                    </div>

                    <i class="bi bi-box-arrow-up-right contact-arrow"
                       aria-hidden="true"></i>

                </a>

                <a href="https://github.com/alejandro-briones"
                   class="contact-link"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label='@Localizer["Contact_GitHubAriaLabel"]'>

                    <div class="contact-link-content">

                        <i class="bi bi-github contact-icon"
                           aria-hidden="true"></i>

                        <div>

                            <span class="contact-label">
                                GitHub
                            </span>

                            <span class="contact-value">
                                @Localizer["Contact_GitHubValue"]
                            </span>

                        </div>

                    </div>

                    <i class="bi bi-box-arrow-up-right contact-arrow"
                       aria-hidden="true"></i>

                </a>

            </div>

        </div>

    </div>

</section>