@inject IStringLocalizer<SharedResource> Localizer

<section id="technologies" class="technologies">

    <div class="container">

        <div class="section-heading">

            <p class="section-label">
                @Localizer["Technologies_Label"]
            </p>

            <h2>
                @Localizer["Technologies_Title"]
            </h2>

        </div>

        <div class="technology-grid">

            <article class="technology-group">

                <p class="technology-category">
                    @Localizer["Technologies_LanguagesWeb"]
                </p>

                <div class="technology-items">
                    <span>C#</span>
                    <span>JavaScript</span>
                    <span>HTML5</span>
                    <span>CSS3</span>
                </div>

            </article>

            <article class="technology-group">

                <p class="technology-category">
                    @Localizer["Technologies_DotNetBackend"]
                </p>

                <div class="technology-items">
                    <span>.NET</span>
                    <span>.NET 10</span>
                    <span>.NET Framework</span>
                    <span>ASP.NET</span>
                    <span>ASP.NET Web Forms</span>
                    <span>Blazor WebAssembly</span>
                    <span>Razor Components</span>
                    <span>WCF / SOAP</span>
                    <span>ADO.NET</span>
                </div>

            </article>

            <article class="technology-group">

                <p class="technology-category">
                    @Localizer["Technologies_DataReporting"]
                </p>

                <div class="technology-items">
                    <span>SQL Server</span>
                    <span>SQL / T-SQL</span>

                    <span>
                        @Localizer["Technologies_RelationalDatabaseDesign"]
                    </span>

                    <span>
                        @Localizer["Technologies_StoredProcedures"]
                    </span>

                    <span>SSRS</span>
                    <span>RDL / RDLC</span>
                    <span>XML</span>
                    <span>JSON</span>
                </div>

            </article>

            <article class="technology-group">

                <p class="technology-category">
                    @Localizer["Technologies_DevelopmentDeployment"]
                </p>

                <div class="technology-items">
                    <span>Git</span>
                    <span>GitHub</span>
                    <span>GitHub Actions</span>
                    <span>GitHub Pages</span>
                    <span>Visual Studio</span>
                    <span>SSDT</span>
                    <span>IIS</span>
                    <span>TFS</span>
                </div>

            </article>

        </div>

    </div>

</section>