@using AlejandroBriones.Portfolio.Services

@inject IStringLocalizer<SharedResource> Localizer
@inject CultureService CultureService

<section id="home" class="hero">

    <div class="hero-container">

        <div class="hero-layout">

            <div class="hero-content">

                <div class="hero-status">

                    <span class="status-indicator"
                          aria-hidden="true"></span>

                    <span>
                        @Localizer["Hero_OpenToRemoteOpportunities"]
                    </span>

                </div>

                <p class="hero-greeting">
                    @Localizer["Hero_Greeting"]
                </p>

                <h1>
                    Alejandro Briones
                </h1>

                <h2>
                    @Localizer["Hero_Role"]
                </h2>

                <p class="hero-specialization">
                    @Localizer["Hero_Specialization"]
                </p>

                <p class="hero-description">
                    @Localizer["Hero_Description"]
                </p>

                <div class="hero-actions">

                    <a href="#contact"
                       class="button button-primary">
                        @Localizer["Hero_ContactMe"]
                    </a>

                    <a href="#projects"
                       class="button button-secondary">
                        @Localizer["Hero_ViewProjects"]
                    </a>

                </div>

                <div class="hero-socials">

                    <a href="https://www.linkedin.com/in/josealejandrobrionesarroyo"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label='@Localizer["Hero_LinkedInAriaLabel"]'>

                        <i class="bi bi-linkedin"
                           aria-hidden="true"></i>

                        LinkedIn
                    </a>

                    <a href="https://github.com/alejandro-briones"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label='@Localizer["Hero_GitHubAriaLabel"]'>

                        <i class="bi bi-github"
                           aria-hidden="true"></i>

                        GitHub
                    </a>

                    <a href="@CultureService.CvPath"
                       download="@CultureService.CvFileName"
                       aria-label='@Localizer["Hero_DownloadCvAriaLabel"]'>

                        <i class="bi bi-download"
                           aria-hidden="true"></i>

                        CV
                    </a>

                </div>

            </div>

            <aside class="hero-stack"
                   aria-label='@Localizer["Hero_CoreStackAriaLabel"]'>

                <div class="stack-header">

                    <span class="stack-title">
                        @Localizer["Hero_CoreStackTitle"]
                    </span>

                    <span class="stack-dot"
                          aria-hidden="true"></span>

                </div>

                <div class="stack-content">

                    <div class="stack-row">

                        <span class="stack-category">
                            @Localizer["Hero_StackLanguage"]
                        </span>

                        <strong>
                            C#
                        </strong>

                    </div>

                    <div class="stack-row">

                        <span class="stack-category">
                            @Localizer["Hero_StackPlatform"]
                        </span>

                        <strong>
                            .NET
                        </strong>

                    </div>

                    <div class="stack-row">

                        <span class="stack-category">
                            @Localizer["Hero_StackWeb"]
                        </span>

                        <strong>
                            ASP.NET
                        </strong>

                    </div>

                    <div class="stack-row">

                        <span class="stack-category">
                            @Localizer["Hero_StackData"]
                        </span>

                        <strong>
                            SQL Server
                        </strong>

                    </div>

                </div>

                <div class="stack-footer">

                    <i class="bi bi-code-slash"
                       aria-hidden="true"></i>

                    <span>
                        @Localizer["Hero_StackFooter"]
                    </span>

                </div>

            </aside>

        </div>

    </div>

</section>