@inject IStringLocalizer<SharedResource> Localizer

<section id="projects" class="projects">

    <div class="container">

        <div class="section-heading">

            <p class="section-label">
                @Localizer["Projects_Label"]
            </p>

            <h2>
                @Localizer["Projects_Title"]
            </h2>

        </div>

        <div class="projects-grid">

            <article class="project-card">

                <div class="project-header">

                    <span class="project-type">
                        @Localizer["Projects_Professional"]
                    </span>

                    <span class="project-number">
                        01
                    </span>

                </div>

                <div class="project-content">

                    <h3>
                        @Localizer["Projects_BillingTitle"]
                    </h3>

                    <p>
                        @Localizer["Projects_BillingDescription1"]
                    </p>

                    <p>
                        @Localizer["Projects_BillingDescription2"]
                    </p>

                </div>

                <div class="technology-list">
                    <span>C#</span>
                    <span>.NET Framework</span>
                    <span>ASP.NET Web Forms</span>
                    <span>WCF / SOAP</span>
                    <span>SQL Server</span>
                    <span>T-SQL</span>
                    <span>SSRS/RDLC</span>
                    <span>XML</span>
                    <span>IIS</span>
                    <span>TFS</span>
                </div>

            </article>

            <article class="project-card">

                <div class="project-header">

                    <span class="project-type">
                        @Localizer["Projects_Professional"]
                    </span>

                    <span class="project-number">
                        02
                    </span>

                </div>

                <div class="project-content">

                    <h3>
                        @Localizer["Projects_AccountStatementTitle"]
                    </h3>

                    <p>
                        @Localizer["Projects_AccountStatementDescription1"]
                    </p>

                    <p>
                        @Localizer["Projects_AccountStatementDescription2"]
                    </p>

                </div>

                <div class="technology-list">
                    <span>C#</span>
                    <span>.NET Framework</span>
                    <span>ASP.NET Web Forms</span>
                    <span>WCF / SOAP</span>
                    <span>SQL Server</span>
                    <span>T-SQL</span>
                    <span>SSRS/RDLC</span>
                    <span>IIS</span>
                    <span>TFS</span>
                </div>

            </article>

            <article class="project-card">

                <div class="project-header">

                    <span class="project-type">
                        @Localizer["Projects_Professional"]
                    </span>

                    <span class="project-number">
                        03
                    </span>

                </div>

                <div class="project-content">

                    <h3>
                        @Localizer["Projects_ReinsurancePolicyTitle"]
                    </h3>

                    <p>
                        @Localizer["Projects_ReinsurancePolicyDescription1"]
                    </p>

                    <p>
                        @Localizer["Projects_ReinsurancePolicyDescription2"]
                    </p>

                </div>

                <div class="technology-list">
                    <span>C#</span>
                    <span>.NET Framework</span>
                    <span>ASP.NET Web Forms</span>
                    <span>WCF / SOAP</span>
                    <span>SQL Server</span>
                    <span>T-SQL</span>
                    <span>TFS</span>
                </div>

            </article>

            <article class="project-card">

                <div class="project-header">

                    <span class="project-type">
                        @Localizer["Projects_Personal"]
                    </span>

                    <span class="project-number">
                        04
                    </span>

                </div>

                <div class="project-content">

                    <h3>
                        @Localizer["Projects_PortfolioTitle"]
                    </h3>

                    <p>
                        @Localizer["Projects_PortfolioDescription1"]
                    </p>

                    <p>
                        @Localizer["Projects_PortfolioDescription2"]
                    </p>

                    <div class="project-links">

                        <a href="https://github.com/alejandro-briones/alejandro-briones-portfolio"
                           target="_blank"
                           rel="noopener noreferrer">

                            <i class="bi bi-github"
                               aria-hidden="true"></i>

                            @Localizer["Projects_SourceCode"]
                        </a>

                    </div>

                </div>

                <div class="technology-list">
                    <span>C#</span>
                    <span>.NET 10</span>
                    <span>Blazor WebAssembly</span>
                    <span>Razor Components</span>
                    <span>JavaScript</span>
                    <span>HTML5</span>
                    <span>CSS3</span>
                    <span>Git</span>
                    <span>GitHub</span>
                    <span>GitHub Actions</span>
                    <span>GitHub Pages</span>
                </div>

            </article>

        </div>

    </div>

</section>