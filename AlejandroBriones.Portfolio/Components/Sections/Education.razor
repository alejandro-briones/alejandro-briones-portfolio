@inject IStringLocalizer<SharedResource> Localizer

<section id="education" class="education">

    <div class="container">

        <div class="section-heading">

            <p class="section-label">
                @Localizer["Education_Label"]
            </p>

            <h2>
                @Localizer["Education_Title"]
            </h2>

        </div>

        <div class="education-grid">

            <div class="education-column">

                <p class="column-title">
                    @Localizer["Education_AcademicBackground"]
                </p>

                <article class="education-item">

                    <div class="education-header">

                        <div>

                            <h3>
                                @Localizer["Education_BachelorTitle"]
                            </h3>

                            <p class="institution">
                                Universidad Tecnológica de Xicotepec de Juárez
                            </p>

                        </div>

                        <span class="education-period">

                            <time datetime="2024-09">
                                2024
                            </time>

                            <span aria-hidden="true">
                                —
                            </span>

                            <time datetime="2026-04">
                                2026
                            </time>

                        </span>

                    </div>

                    <p class="education-description">
                        @Localizer["Education_BachelorDescription1"]
                    </p>

                    <p class="education-description">
                        @Localizer["Education_BachelorDescription2"]
                    </p>

                </article>

                <article class="education-item">

                    <div class="education-header">

                        <div>

                            <h3>
                                @Localizer["Education_AssociateTitle"]
                            </h3>

                            <p class="institution">
                                Universidad Tecnológica de Xicotepec de Juárez
                            </p>

                        </div>

                        <span class="education-period">

                            <time datetime="2022-09">
                                2022
                            </time>

                            <span aria-hidden="true">
                                —
                            </span>

                            <time datetime="2024-08">
                                2024
                            </time>

                        </span>

                    </div>

                    <p class="education-description">
                        @Localizer["Education_AssociateDescription1"]
                    </p>

                    <p class="education-description">
                        @Localizer["Education_AssociateDescription2"]
                    </p>

                </article>

            </div>

            <div class="education-column">

                <p class="column-title">
                    @Localizer["Education_ProfessionalLearning"]
                </p>

                <article class="education-item">

                    <div class="education-header">

                        <div>

                            <h3>
                                @Localizer["Education_FullStackCertificateTitle"]
                            </h3>

                            <p class="institution">
                                Microsoft · Coursera
                            </p>

                        </div>

                        <span class="status">
                            @Localizer["Education_InProgress"]
                        </span>

                    </div>

                    <p class="education-description">
                        @Localizer["Education_FullStackCertificateDescription"]
                    </p>

                </article>

                <article class="education-item">

                    <div class="education-header">

                        <div>

                            <h3>
                                @Localizer["Education_AzureTitle"]
                            </h3>

                        </div>

                        <span class="status">
                            @Localizer["Education_InProgress"]
                        </span>

                    </div>

                    <p class="education-description">
                        @Localizer["Education_AzureDescription"]
                    </p>

                </article>

            </div>

        </div>

    </div>

</section>