@inject IStringLocalizer<SharedResource> Localizer

<section id="experience" class="experience">

    <div class="container">

        <div class="section-heading">

            <p class="section-label">
                @Localizer["Experience_Label"]
            </p>

            <h2>
                @Localizer["Experience_Title"]
            </h2>

        </div>

        <div class="experience-list">

            <article class="experience-item">

                <div class="experience-meta">
                    <span>
                        @Localizer["Experience_CurrentDate"]
                    </span>
                </div>

                <div class="experience-content">

                    <h3>
                        @Localizer["Experience_CurrentRole"]
                    </h3>

                    <p class="experience-company">
                        Software Avanzado
                    </p>

                    <p class="experience-description">
                        @Localizer["Experience_CurrentDescription1"]
                    </p>

                    <p class="experience-description">
                        @Localizer["Experience_CurrentDescription2"]
                    </p>

                    <div class="technology-list">
                        <span>C#</span>
                        <span>.NET Framework</span>
                        <span>ASP.NET Web Forms</span>
                        <span>SQL Server</span>
                        <span>T-SQL</span>
                        <span>WCF / SOAP</span>
                        <span>SSRS/RDLC</span>
                        <span>JavaScript</span>
                        <span>IIS</span>
                        <span>TFS</span>
                    </div>

                </div>

            </article>

            <article class="experience-item">

                <div class="experience-meta">
                    <span>
                        @Localizer["Experience_DevelopTalentDate"]
                    </span>
                </div>

                <div class="experience-content">

                    <h3>
                        @Localizer["Experience_DevelopTalentRole"]
                    </h3>

                    <p class="experience-company">
                        develop talent &amp; technology
                    </p>

                    <p class="experience-description">
                        @Localizer["Experience_DevelopTalentDescription1"]
                    </p>

                    <p class="experience-description">
                        @Localizer["Experience_DevelopTalentDescription2"]
                    </p>

                    <div class="technology-list">

                        <span>
                            @Localizer["Experience_SoftwareDevelopment"]
                        </span>

                        <span>
                            @Localizer["Experience_Debugging"]
                        </span>

                        <span>
                            @Localizer["Experience_Testing"]
                        </span>

                        <span>
                            @Localizer["Experience_TechnicalDocumentation"]
                        </span>

                    </div>

                </div>

            </article>

            <article class="experience-item">

                <div class="experience-meta">
                    <span>
                        @Localizer["Experience_QNodeDate"]
                    </span>
                </div>

                <div class="experience-content">

                    <h3>
                        @Localizer["Experience_QNodeRole"]
                    </h3>

                    <p class="experience-company">
                        CR-Applications LLC / QNode
                    </p>

                    <p class="experience-description">
                        @Localizer["Experience_QNodeDescription1"]
                    </p>

                    <p class="experience-description">
                        @Localizer["Experience_QNodeDescription2"]
                    </p>

                    <div class="technology-list">
                        <span>Flutter</span>
                        <span>Dart</span>
                        <span>Firebase</span>
                        <span>Git</span>
                        <span>GitHub</span>
                        <span>Figma</span>
                    </div>

                </div>

            </article>

        </div>

    </div>

</section>