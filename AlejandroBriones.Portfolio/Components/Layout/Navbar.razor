@inject IStringLocalizer<SharedResource> Localizer

<header class="navbar">

    <div class="navbar-container">

        <a href="#home"
           class="navbar-brand"
           @onclick="CloseMenu"
           aria-label='@Localizer["Navbar_HomeAriaLabel"]'>

            <span class="brand-symbol">&lt;/</span>
            <span class="brand-initials">alejandro</span>
            <span class="brand-symbol">&gt;</span>

        </a>

        <div class="navbar-actions">

            <nav id="main-navigation"
                 class="navbar-links @(_isMenuOpen ? "open" : "")">

                <a href="#about"
                   @onclick="CloseMenu">
                    @Localizer["Navbar_About"]
                </a>

                <a href="#experience"
                   @onclick="CloseMenu">
                    @Localizer["Navbar_Experience"]
                </a>

                <a href="#projects"
                   @onclick="CloseMenu">
                    @Localizer["Navbar_Projects"]
                </a>

                <a href="#technologies"
                   @onclick="CloseMenu">
                    @Localizer["Navbar_Technologies"]
                </a>

                <a href="#education"
                   @onclick="CloseMenu">
                    @Localizer["Navbar_Education"]
                </a>

                <a href="#contact"
                   @onclick="CloseMenu">
                    @Localizer["Navbar_Contact"]
                </a>

            </nav>

            <ThemeToggle />

            <button type="button"
                    class="menu-toggle @(_isMenuOpen ? "open" : "")"
                    @onclick="ToggleMenu"
                    aria-label="@MenuToggleLabel"
                    aria-expanded="@_isMenuOpen.ToString().ToLowerInvariant()"
                    aria-controls="main-navigation">

                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>

            </button>

        </div>

    </div>

</header>

@code {

    private bool _isMenuOpen;

    private string MenuToggleLabel =>
        _isMenuOpen
            ? Localizer["Navbar_CloseMenuAriaLabel"]
            : Localizer["Navbar_OpenMenuAriaLabel"];

    private void ToggleMenu()
    {
        _isMenuOpen = !_isMenuOpen;
    }

    private void CloseMenu()
    {
        _isMenuOpen = false;
    }

}