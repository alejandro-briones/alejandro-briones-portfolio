@inject IStringLocalizer<SharedResource> Localizer

<footer class="footer">

    <div class="footer-container">

        <div class="footer-main">

            <div class="footer-identity">

                <p class="footer-name">
                    Jose Alejandro Briones Arroyo
                </p>

                <p class="footer-role">
                    @Localizer["Footer_Role"]
                </p>

            </div>

            <a href="#home"
               class="back-to-top">

                @Localizer["Footer_BackToTop"]

                <i class="bi bi-arrow-up"
                   aria-hidden="true"></i>

            </a>

        </div>

        <div class="footer-bottom">

            <p>
                © @_currentYear Jose Alejandro Briones Arroyo
            </p>

            <p>
                @Localizer["Footer_BuiltWith"]
            </p>

        </div>

    </div>

</footer>

@code {

    private readonly int _currentYear =
        DateTime.Now.Year;

}